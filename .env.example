# Copy to .env only if you need to override defaults. Never put real secrets here:
# this repository is public (see docs/security.md).

# ── Web (apps/web) — public values, they end up in the HTML ─────────────────────
# Local default: Cloudflare Turnstile public test key (always passes).
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
PUBLIC_API_URL=http://localhost:8787
