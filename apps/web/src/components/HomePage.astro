---
import type { Locale } from '@portfolio/shared'

import { SKILLS } from '../data/skills'
import { getUi } from '../i18n'
import { loadProjects } from '../lib/content'
import Base from '../layouts/Base.astro'
import Footer from './Footer.astro'
import Nav from './Nav.astro'
import SectionHeading from './SectionHeading.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const ui = getUi(locale)
const projects = await loadProjects(locale)
const structured_projects = projects.map((project) => ({
  name: project.title,
  description: project.summary,
  url: project.url,
}))
const knows_about = SKILLS.filter((skill) => skill.level >= 6).map((skill) => skill.label)
---

<Base locale={locale} projects={structured_projects} knows_about={knows_about}>
  <Nav slot="header" locale={locale} />

  <section
    id="top"
    class="container-page flex min-h-[calc(100dvh-4rem)] flex-col justify-center py-16"
  >
    <p class="font-mono text-small text-ink-muted">{ui.hero.greeting}</p>
    <h1 class="text-hero font-extrabold">
      Luis Ventura E<span class="text-accent">.</span>
    </h1>
    <p class="mt-6 max-w-[40ch] text-title leading-tight text-ink-muted">{ui.hero.tagline}</p>
  </section>

  <section id="stack" aria-labelledby="stack-title" class="container-page py-(--space-section)">
    <SectionHeading id="stack" index="01" title={ui.stack.title} intro={ui.stack.intro} />
  </section>

  <section
    id="projects"
    aria-labelledby="projects-title"
    class="container-page py-(--space-section)"
  >
    <SectionHeading id="projects" index="02" title={ui.projects.title} intro={ui.projects.intro} />
    <ul class="grid gap-4 md:grid-cols-2">
      {projects.map((project) => (
        <li class="rounded-lg border border-line bg-paper-raised p-6">
          <p class="font-mono text-small text-ink-muted">
            {project.company} · {project.period}
          </p>
          <h3 class="mt-2 text-title font-bold">{project.title}</h3>
          <p class="mt-1 text-ink-muted">{project.summary}</p>
        </li>
      ))}
    </ul>
  </section>

  <section
    id="terminal"
    aria-labelledby="terminal-title"
    class="container-page py-(--space-section)"
  >
    <SectionHeading id="terminal" index="03" title={ui.terminal.title} intro={ui.terminal.intro} />
  </section>

  <section id="contact" aria-labelledby="contact-title" class="container-page py-(--space-section)">
    <SectionHeading id="contact" index="04" title={ui.contact.title} intro={ui.contact.intro} />
  </section>

  <Footer slot="footer" locale={locale} />
</Base>
