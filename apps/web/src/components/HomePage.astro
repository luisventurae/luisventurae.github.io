---
import type { Locale } from '@portfolio/shared'

import { getImage } from 'astro:assets'

import { PERSON } from '../data/site'
import { SKILLS, sortByTier } from '../data/skills'
import { getUi } from '../i18n'
import { loadExperience, loadProfile, loadProjects } from '../lib/content'
import { careerYears, interpolateYears } from '../lib/experience'
import type { TerminalContext } from '../lib/terminal/commands'
import { skillUsage } from '../lib/projects'
import { parsePublicEnv } from '../lib/public-env'
import type { ProjectCard } from './projects/types'
import { ContactForm } from './contact/ContactForm'
import { ProjectGrid } from './projects/ProjectGrid'
import { StackMap, type StackSkill } from './stack/StackMap'
import { Terminal } from './terminal/Terminal'
import Base from '../layouts/Base.astro'
import ExperienceTimeline from './experience/ExperienceTimeline.astro'
import Footer from './Footer.astro'
import { Hero } from './hero/Hero'
import Nav from './Nav.astro'
import SectionHeading from './SectionHeading.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const ui = getUi(locale)
const years = careerYears()
const projects = await loadProjects(locale)
const experience = await loadExperience(locale)
const structured_projects = projects.map((project) => ({
  name: project.title,
  description: project.summary,
  url: project.url,
}))
const knows_about = SKILLS.filter((skill) => skill.tier !== 'exploring').map((skill) => skill.label)

const usage = skillUsage(projects)
const skill_by_id = new Map(SKILLS.map((skill) => [skill.id, skill]))
const stack_skills: StackSkill[] = sortByTier(SKILLS).map((skill) => ({
  id: skill.id,
  label: skill.label,
  category: skill.category,
  tier: skill.tier,
  project_count: usage[skill.id] ?? 0,
}))

const project_cards: ProjectCard[] = await Promise.all(
  projects.map(async (project) => ({
    slug: project.slug,
    title: project.title,
    summary: project.summary,
    company: project.company,
    period: project.period,
    url: project.url,
    body_html: project.body_html,
    techs: project.techs.flatMap((id) => {
      const skill = skill_by_id.get(id)
      return skill ? [{ id, label: skill.label, category: skill.category }] : []
    }),
    media: await Promise.all(
      project.media.map(async (image) => {
        const optimized = await getImage({ src: image, widths: [480, 960, 1440], format: 'webp' })
        return {
          src: optimized.src,
          srcset: optimized.srcSet.attribute,
          width: image.width,
          height: image.height,
          alt: `${project.title} — ${project.summary}`,
        }
      }),
    ),
  })),
)
const stack_labels = {
  all: ui.stack.all,
  categories: ui.stack.categories,
  tiers: ui.stack.tiers,
  tiers_legend: ui.stack.tiers_legend,
  no_projects: ui.stack.no_projects,
  used_in: ui.stack.used_in,
  clear: ui.stack.clear,
  see_projects: ui.stack.see_projects,
}
const { PUBLIC_API_URL: api_url, PUBLIC_TURNSTILE_SITE_KEY: turnstile_site_key } = parsePublicEnv(
  import.meta.env,
)
const contact_labels = {
  email: ui.contact.email,
  company: ui.contact.company,
  submit: ui.contact.submit,
  sending: ui.contact.sending,
  success: ui.contact.success,
  download_again: ui.contact.download_again,
  errors: ui.contact.errors,
}
const profile = await loadProfile(locale)
const project_titles = Object.fromEntries(projects.map((project) => [project.slug, project.title]))
const tech_labels = Object.fromEntries(SKILLS.map((skill) => [skill.id, skill.label]))
const experience_labels = {
  present: ui.experience.present,
  kinds: ui.experience.kinds,
  projects: ui.experience.projects,
}
const terminal_context: TerminalContext = {
  locale,
  messages: ui.terminal.messages,
  category_labels: ui.stack.categories,
  tier_labels: ui.stack.tiers,
  whoami: profile.body.split('\n\n')[0]?.trim() ?? '',
  projects: projects.map((project) => ({
    slug: project.slug,
    title: project.title,
    summary: project.summary,
    company: project.company,
    period: project.period,
    techs: project.techs.map((id) => skill_by_id.get(id)?.label ?? id),
  })),
  skills: SKILLS.map((skill) => ({
    label: skill.label,
    category: skill.category,
    tier: skill.tier,
  })),
}
const project_labels = {
  open: ui.projects.open,
  period: ui.projects.period,
  technologies: ui.projects.technologies,
  visit: ui.projects.visit,
  previous: ui.projects.previous,
  next: ui.projects.next,
  close: ui.projects.close,
  swipe_hint: ui.projects.swipe_hint,
}
---

<Base locale={locale} projects={structured_projects} knows_about={knows_about}>
  <Nav slot="header" locale={locale} />

  <section
    id="top"
    class="container-page flex min-h-[calc(100dvh-4rem)] flex-col justify-center py-16"
  >
    <Hero
      client:load
      name="Luis Ventura E"
      greeting={ui.hero.greeting}
      role={PERSON.job_title}
      facts={interpolateYears(ui.hero.facts, years)}
      availability={ui.hero.availability}
      roles={ui.hero.roles}
      tagline={ui.hero.tagline}
      drag_hint={ui.hero.drag_hint}
      cta_projects={ui.hero.cta_projects}
      cta_terminal={ui.hero.cta_terminal}
    />
  </section>

  <section id="about" aria-labelledby="about-title" class="container-page py-(--space-section)">
    <SectionHeading id="about" index="01" title={ui.about.title} intro={ui.about.intro} />
    <div class="about-body max-w-[65ch]" set:html={profile.body_html} />
  </section>

  <section
    id="experience"
    aria-labelledby="experience-title"
    class="container-page py-(--space-section)"
  >
    <SectionHeading
      id="experience"
      index="02"
      title={ui.experience.title}
      intro={ui.experience.intro}
    />
    <ExperienceTimeline
      locale={locale}
      items={experience}
      project_titles={project_titles}
      tech_labels={tech_labels}
      labels={experience_labels}
    />
  </section>

  <section
    id="projects"
    aria-labelledby="projects-title"
    class="container-page py-(--space-section)"
  >
    <SectionHeading id="projects" index="03" title={ui.projects.title} intro={ui.projects.intro} />
    <ProjectGrid client:visible projects={project_cards} labels={project_labels} />
  </section>

  <section id="stack" aria-labelledby="stack-title" class="container-page py-(--space-section)">
    <SectionHeading id="stack" index="04" title={ui.stack.title} intro={ui.stack.intro} />
    <StackMap client:visible skills={stack_skills} labels={stack_labels} />
  </section>

  <section id="contact" aria-labelledby="contact-title" class="container-page py-(--space-section)">
    <SectionHeading id="contact" index="05" title={ui.contact.title} intro={ui.contact.intro} />
    <ContactForm
      client:visible
      locale={locale}
      api_url={api_url}
      turnstile_site_key={turnstile_site_key}
      labels={contact_labels}
    />
  </section>

  <section
    id="terminal"
    aria-labelledby="terminal-title"
    class="container-page py-(--space-section)"
  >
    <SectionHeading id="terminal" index="06" title={ui.terminal.title} intro={ui.terminal.intro} />
    <Terminal client:idle input_label={ui.terminal.input_label} context={terminal_context} />
    <p class="mt-3 text-small text-ink-muted">
      {ui.terminal.shortcut_hint}
      <kbd class="ml-1 rounded border border-line bg-paper-raised px-1.5 font-mono">`</kbd>
    </p>
  </section>

  <Footer slot="footer" locale={locale} />
</Base>
