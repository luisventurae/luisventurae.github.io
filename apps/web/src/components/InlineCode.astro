---
/** Renders `backtick` segments of a plain string as <code>. */
interface Props {
  text: string
}

const parts = Astro.props.text.split('`')
---

{parts.map((part, index) =>
  index % 2 === 1 ? (
    <code class="rounded bg-line/70 px-1.5 py-0.5 font-mono text-[0.9em] text-ink">{part}</code>
  ) : (
    part
  ),
)}
